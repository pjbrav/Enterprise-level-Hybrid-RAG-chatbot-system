# Copy to .env and edit. Every value is optional.

# ---- Storage -------------------------------------------------------------
# Leave DATABASE_URL empty for SQLite (one file per corpus under DATA_DIR/corpora).
# Set it to use PostgreSQL (+ pgvector): one schema per corpus. `docker compose up` provides one.
DATABASE_URL=
DATA_DIR=data
# Existing database used by the Evaluate tab / scripts (attach it read-only under "My library")
SQLITE_DATABASE_PATH=data/hybrid_rag_v22.db
PG_POOL_MAX=10

# ---- Network -------------------------------------------------------------
# The admin UI is for you: keep it on localhost. Only the host API (started from the Host tab) is shared.
GRADIO_BIND=127.0.0.1
GRADIO_PORT=7860
HOST_BIND=0.0.0.0
HOST_PORT=8765
# On a localhost UI your keys below are used when the key box is left empty. When GRADIO_BIND is a
# network address they are NOT (visitors must type their own) unless you set this to 1.
# UI_ALLOW_SERVER_KEYS=0
# Seconds to wait for a host to answer a retrieval request (cold queries on a huge corpus can be slow)
REMOTE_TIMEOUT=120

# ---- LLM providers (the key box in the UI overrides these for the selected provider) -------------
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
# Ollama needs no key. Setting OLLAMA_MODEL also adds it to the automatic provider chain.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=
# Any other OpenAI-compatible server
COMPATIBLE_BASE_URL=
COMPATIBLE_MODEL=
COMPATIBLE_API_KEY=

# ---- Retrieval tuning (defaults reproduce the published evaluation = slider position 0.5) ------------
ROUTER_STANDARD_CONFIDENCE_HIGH=2.0
ROUTER_STANDARD_CONFIDENCE_LOW=0.42
ROUTER_HYBRID_SCORE_THRESHOLD=0.50
ROUTER_LAST_RESORT_THRESHOLD=0.40
LAST_RESORT_CANDIDATE_POOL=20
LEXICAL_CALIBRATION_PIVOT=10.0
MIN_THRESHOLD=0.20
CROSS_DOMAIN_THRESHOLD_RELIEF=0.12
MAX_FTS_QUERY_TERMS=6
MAX_FTS_TERM_FANOUT=20000
MAX_ENTITY_FANOUT=5000
PARALLEL_PARTITIONS=1
